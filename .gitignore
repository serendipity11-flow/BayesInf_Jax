# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Experiment tracking
wandb/

# Generated datasets and experiment outputs
data/**
!data/**/
!data/**/README.md
!data/**/provenance.yaml
results/

# Checkpoints and logs
*.eqx
*.npz
*.parquet
*.pt
*.pth
*.out
*.err

# This repository intentionally versions the curated dataset snapshots.
!data/**

# Node-local dependency caches generated by Slurm jobs. These can contain
# multi-gigabyte CUDA/JAX installations and must never be committed.
data/**/.slurm_python_packages/

# Generated off-road dataset arrays. Keep metadata and scripts in Git, but
# regenerate or store these binary artifacts outside the repository history.
data/offroad_flowsde/*.h5
data/offroad_flowsde/*.hdf5
data/offroad_flowsde/*.npz
