<mujoco model="flow_sde_pusher_passage">
  <compiler angle="radian"/>
  <option timestep="0.02" gravity="0 0 -9.81" integrator="RK4"/>
  <default>
    <joint damping="1.5" armature="0.05"/>
    <geom friction="0.9 0.08 0.02" condim="4"/>
    <motor ctrllimited="true" ctrlrange="-5 5"/>
  </default>

  <asset>
    <material name="arm" rgba="0.18 0.35 0.75 1"/>
    <material name="object" rgba="0.9 0.35 0.12 1"/>
    <material name="wall" rgba="0.25 0.25 0.28 1"/>
    <material name="target" rgba="0.15 0.8 0.25 0.35"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 1.3 0.05" rgba="0.92 0.92 0.92 1"/>

    <!-- Two walls leave a 0.30 m passage centered at y=0. -->
    <geom name="wall_upper" type="box" pos="0.28 0.46 0.10"
          size="0.055 0.31 0.10" material="wall"/>
    <geom name="wall_lower" type="box" pos="0.28 -0.46 0.10"
          size="0.055 0.31 0.10" material="wall"/>
    <geom name="target" type="cylinder" pos="0.68 0 0.006"
          size="0.11 0.006" material="target" contype="0" conaffinity="0"/>

    <body name="arm_base" pos="-0.72 0 0.08">
      <joint name="shoulder" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
      <geom type="capsule" fromto="0 0 0 0.34 0 0" size="0.035" material="arm"/>
      <body name="link2" pos="0.34 0 0">
        <joint name="elbow" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
        <geom type="capsule" fromto="0 0 0 0.30 0 0" size="0.032" material="arm"/>
        <body name="link3" pos="0.30 0 0">
          <joint name="wrist" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
          <geom type="capsule" fromto="0 0 0 0.22 0 0" size="0.028" material="arm"/>
          <body name="fingertip" pos="0.22 0 0">
            <geom name="pusher" type="sphere" size="0.055" material="arm"/>
          </body>
        </body>
      </body>
    </body>

    <body name="cuboid" pos="-0.05 0 0.055">
      <joint name="object_x" type="slide" axis="1 0 0"/>
      <joint name="object_y" type="slide" axis="0 1 0"/>
      <joint name="object_yaw" type="hinge" axis="0 0 1"/>
      <geom name="object_geom" type="box" size="0.09 0.055 0.055"
            density="420" material="object"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="1"/>
    <motor name="elbow_motor" joint="elbow" gear="1"/>
    <motor name="wrist_motor" joint="wrist" gear="1"/>
  </actuator>
</mujoco>
